# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (DB + pseudonym map) — never commit
/data/
*.db
*.db-journal

# WhatsApp exports / fixtures that may contain real chat data — never commit
*.zip
_chat.txt
chat.txt
chat.md
public/__fixture*

# local Claude Code worktrees
.claude/worktrees/
