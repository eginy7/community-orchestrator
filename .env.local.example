# Copy to .env.local (gitignored) and fill in:
ANTHROPIC_API_KEY=sk-ant-...
# Optional: where the SQLite DB and pseudonym map live (default: ./data)
# COMMUNITY_DATA_DIR=./data

# --- Auth (optional; see README "Auth setup") ---
# Leave all three unset for local development: the app then runs without sign-in and everyone is an admin.
# Supabase project → Settings → API. The anon key is public by design; the service role key is NOT needed.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# Comma-separated Google account emails that get the full admin app (case-insensitive).
# ADMIN_EMAILS=manager@example.com,second-manager@example.com
